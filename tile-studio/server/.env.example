# AI provider: huggingface, gemini, or openai
AI_PROVIDER=huggingface

# Hugging Face Inference Providers
# Create an Inference token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# Image editing model (room-photo edits)
HF_MODEL=black-forest-labs/FLUX.1-Kontext-dev

# Text-to-image model (custom tile generation)
HF_GENERATE_MODEL=black-forest-labs/FLUX.1-dev

# Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-image

# OpenAI
OPENAI_API_KEY=

# Optional
PORT=3000

# Vision models used only for room geometry analysis (NOT tile rendering)
HF_VISION_MODEL=CohereLabs/command-a-vision-07-2025
HF_VISION_PROVIDER=auto
# If HF_VISION_MODEL fails (e.g. its provider is down/unsupported for your
# account), these are tried next, in order. Comma-separated, no spaces needed.
# Default if unset: Qwen/Qwen2.5-VL-7B-Instruct,Qwen/Qwen2.5-VL-3B-Instruct
# HF_VISION_MODEL_FALLBACKS=Qwen/Qwen2.5-VL-7B-Instruct,Qwen/Qwen2.5-VL-3B-Instruct
GEMINI_VISION_MODEL=gemini-2.5-flash
OPENAI_VISION_MODEL=gpt-4.1-mini
